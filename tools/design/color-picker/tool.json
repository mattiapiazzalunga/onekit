{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "color-picker",
  "name": "Color Picker",
  "group": "design",
  "handler": "photo_tools",
  "accepts": [
    "png",
    "jpeg",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "ico",
    "txt"
  ],
  "produces": "json",
  "fidelity": "exact",
  "note": "Read a six-digit HEX color from TXT or sample an EXIF-oriented image pixel. Reports visible sRGB, original RGBA, OKLCH and text contrast. Transparent pixels are composited on white.",
  "packages": [
    "Pillow"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "x",
    "y"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
