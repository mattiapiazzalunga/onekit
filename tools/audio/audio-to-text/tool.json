  "id": "audio-to-text",
  "name": "Audio to text",
  "group": "audio",
  "handler": "transcription",
  "accepts": [
    "mp3",
    "wav",
    "flac",
    "ogg",
    "aac",
    "m4a",
    "mp4",
    "aif",
    "aiff",
    "opus",
    "wma"
  ],
  "produces": "txt",
  "fidelity": "compromise",
