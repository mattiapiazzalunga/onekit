{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "security-decrypt",
  "name": "Decrypt files or folders",
  "group": "security",
  "handler": "security",
  "accepts": [
    "onekit"
  ],
  "produces": "*",
  "browser": true,
  "fidelity": "exact",
  "note": "Authenticated AES-256-GCM with scrypt. Losing the password makes recovery impossible.",
  "packages": [
    "pycryptodome"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "password",
    "restore"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728,
  "browser_max_total_bytes": 33554432,
  "browser_max_file_bytes": 33554432
}
