{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "signature-verify",
  "name": "Verify digital signature",
  "group": "security",
  "handler": "signatures",
  "accepts": [
    "*"
  ],
  "produces": "json",
  "fidelity": "exact",
  "note": "Checks PDF and CMS signatures locally with AdES validation. Detached signatures require the original file. Optionally add one signature evidence ZIP. Missing trust or revocation evidence gives an indeterminate result.",
  "packages": [
    "pypdf",
    "asn1crypto",
    "pycryptodome",
    "pyhanko",
    "pyhanko-certvalidator",
    "cryptography",
    "signxml",
    "xsdata"
  ],
  "engines": [],
  "multiple": true,
  "options": [],
  "input_mode": "any",
  "min_files": 1,
  "max_files": 3,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
