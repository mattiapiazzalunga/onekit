{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "video-convert",
  "name": "Convert video",
  "group": "video",
  "handler": "media",
  "accepts": [
    "mp4",
    "webm",
    "mkv",
    "mov",
    "avi",
    "gif",
    "mpeg",
    "mpg",
    "m4v",
    "ogv",
    "ts"
  ],
  "produces": "*",
  "browser": false,
  "fidelity": "compromise",
  "note": "Available codecs depend on your FFmpeg build; re-encoding can lose quality.",
  "packages": [],
  "engines": [
    "ffmpeg",
    "ffprobe"
  ],
  "multiple": false,
  "options": [
    "format",
    "codec",
    "bitrate"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728,
  "browser_max_total_bytes": 33554432,
  "browser_max_file_bytes": 33554432
}
