{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "ocr-to-pdf",
  "name": "OCR to PDF",
  "group": "ocr",
  "handler": "ocr",
  "accepts": [
    "pdf",
    "png",
    "jpeg",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "ico"
  ],
  "produces": "pdf",
  "browser": false,
  "fidelity": "compromise",
  "note": "Recognition depends on scan quality and installed language packs. Equations and layout may need manual correction.",
  "packages": [
    "pytesseract",
    "Pillow",
    "pypdfium2",
    "python-docx"
  ],
  "engines": [
    "tesseract"
  ],
  "multiple": false,
  "options": [
    "language",
    "dpi"
  ]
}
