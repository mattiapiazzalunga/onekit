  "id": "pdf-validate-pdfa",
  "name": "Validate PDF/A",
  "group": "pdf",
  "handler": "pdf",
  "accepts": [
    "pdf"
  ],
  "produces": "json",
  "fidelity": "exact",
  "note": "Validate PDF/A-1b, 2b or 3b with pikepdf. Unsupported constructs are reported as not checked, never as compliant. Other conformance levels are not supported.",
  "packages": [
    "pikepdf",
    "jsonschema",
    "fonttools"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "profile"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
