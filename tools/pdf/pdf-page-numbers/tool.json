{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "pdf-page-numbers",
  "name": "Add page numbers to PDF",
  "group": "pdf",
  "handler": "pdf.page_numbers",
  "accepts": [
    "pdf"
  ],
  "produces": "pdf",
  "fidelity": "exact",
  "note": "Adds sequential numbers to all or selected pages, retaining source text and graphics. Existing digital signatures are invalidated.",
  "packages": [
    "pypdf",
    "reportlab"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "pages",
    "start_number",
    "number_style",
    "font_size",
    "position",
    "margin",
    "color"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
