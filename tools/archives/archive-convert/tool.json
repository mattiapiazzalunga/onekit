{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "archive-convert",
  "name": "Convert archive",
  "group": "archives",
  "handler": "archives",
  "accepts": [
    "zip",
    "tar",
    "gz",
    "bz2",
    "xz"
  ],
  "produces": "*",
  "browser": true,
  "fidelity": "exact",
  "note": "ZIP and TAR variants are supported. Archive links and unsafe paths are rejected.",
  "packages": [],
  "engines": [],
  "multiple": false,
  "options": [
    "format"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728,
  "browser_max_total_bytes": 33554432,
  "browser_max_file_bytes": 33554432
}
