  "id": "pdf-to-pdfa",
  "name": "PDF to PDF/A",
  "group": "converters",
  "handler": "converters",
  "accepts": [
    "pdf"
  ],
  "produces": "pdfa",
  "fidelity": "compromise",
  "note": "Convert to PDF/A-2b or 3b locally with embedded fonts. The exact output is validated before download. Unsupported content can be removed or rejected; review the result.",
  "packages": [
    "pdftopdfa",
    "pikepdf",
    "jsonschema",
    "fonttools",
    "pdfminer.six"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "icc_profile",
    "profile"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
