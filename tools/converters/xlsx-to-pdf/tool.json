{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "xlsx-to-pdf",
  "name": "Excel to PDF",
  "group": "converters",
  "handler": "converters",
  "accepts": [
    "xlsx"
  ],
  "produces": "pdf",
  "browser": false,
  "fidelity": "compromise",
  "note": "Formatting, fonts, layout, formulas or unsupported elements may change. Scanned PDFs require OCR first.",
  "packages": [
    "openpyxl"
  ],
  "engines": [
    "soffice"
  ],
  "multiple": false,
  "options": [
    "sheet"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728,
  "browser_max_total_bytes": 33554432,
  "browser_max_file_bytes": 33554432
}
