{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "image-to-pdf",
  "name": "Image to PDF",
  "group": "converters",
  "handler": "converters",
  "accepts": [
    "png",
    "jpeg",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "ico"
  ],
  "produces": "pdf",
  "browser": true,
  "fidelity": "compromise",
  "note": "Formatting, fonts, layout, formulas or unsupported elements may change. Scanned PDFs require OCR first.",
  "packages": [
    "Pillow"
  ],
  "engines": [],
  "multiple": false,
  "options": []
}
