  "id": "image-to-pdf",
  "name": "Image to PDF",
  "group": "converters",
  "handler": "converters",
  "accepts": [
    "png",
    "jpeg",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "ico"
  ],
  "produces": "pdf",
  "fidelity": "compromise",
  "note": "Formatting, fonts, layout, formulas or unsupported elements may change. Scanned PDFs require OCR first.",
  "packages": [
    "Pillow"
  ],
  "engines": [],
  "multiple": false,
  "options": [],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 67108864,
  "max_total_bytes": 134217728
}
