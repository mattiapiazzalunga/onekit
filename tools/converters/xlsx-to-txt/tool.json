  "id": "xlsx-to-txt",
  "name": "Excel to TXT",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "xlsx"
  ],
  "produces": "txt",
  "fidelity": "compromise",
  "note": "Exports one Excel worksheet as tab-separated UTF-8 text. Uses stored formula results without recalculation; formatting and other sheets are omitted.",
  "packages": [
    "openpyxl"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "sheet"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
