  "id": "csv-to-txt",
  "name": "CSV to TXT",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "csv"
  ],
  "produces": "txt",
  "fidelity": "exact",
  "note": "Converts CSV rows into quoted, tab-separated UTF-8 TXT. Select the input delimiter. Embedded tabs and newlines remain quoted.",
  "packages": [],
  "engines": [],
  "multiple": false,
  "options": [
    "delimiter"
  ],
  "input_mode": "text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
