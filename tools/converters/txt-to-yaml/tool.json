{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "txt-to-yaml",
  "name": "TXT to YAML",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "txt"
  ],
  "produces": "yaml",
  "fidelity": "exact",
  "note": "Requires valid YAML contained in the TXT file. Validates and preserves its source and comments; unsupported values, duplicate keys and unsafe tags are rejected.",
  "packages": [
    "PyYAML"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "source_encoding"
  ],
  "input_mode": "encoded-text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
