{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "txt-to-docx",
  "name": "TXT to Word",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "txt"
  ],
  "produces": "docx",
  "fidelity": "compromise",
  "note": "Creates a Word DOCX document from plain text, using one paragraph per line. No formatting or document structure is inferred.",
  "packages": [
    "python-docx"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "source_encoding"
  ],
  "input_mode": "encoded-text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
