{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "txt-to-xml",
  "name": "TXT to XML",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "txt"
  ],
  "produces": "xml",
  "fidelity": "exact",
  "note": "Requires valid XML already contained in the TXT file. Validates its markup and writes UTF-8 XML; DTDs and entities are rejected.",
  "packages": [
    "defusedxml"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "source_encoding"
  ],
  "input_mode": "encoded-text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
