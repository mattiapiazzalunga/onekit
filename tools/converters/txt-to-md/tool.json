{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "txt-to-md",
  "name": "TXT to Markdown",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "txt"
  ],
  "produces": "md",
  "fidelity": "exact",
  "note": "Wraps plain TXT in a literal Markdown code block, preserving whitespace and syntax. Headings, lists and links are not inferred.",
  "packages": [],
  "engines": [],
  "multiple": false,
  "options": [
    "source_encoding"
  ],
  "input_mode": "encoded-text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
