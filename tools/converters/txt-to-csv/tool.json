{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "txt-to-csv",
  "name": "TXT to CSV",
  "group": "converters",
  "handler": "text_converters",
  "accepts": [
    "txt"
  ],
  "produces": "csv",
  "fidelity": "exact",
  "note": "Parses consistently delimited TXT rows and writes comma-separated CSV. Choose tabs, commas, semicolons, pipes or automatic detection. No column structure is guessed from prose.",
  "packages": [],
  "engines": [],
  "multiple": false,
  "options": [
    "delimiter",
    "source_encoding"
  ],
  "input_mode": "encoded-text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728
}
