  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "LicenseRef-PolyForm-Shield-1.0.0",
  "id": "pdf-tables-to-xlsx",
  "name": "PDF tables to Excel",
  "group": "converters",
  "handler": "pdf_tables",
  "accepts": [
    "pdf"
  ],
  "produces": "xlsx",
  "fidelity": "compromise",
  "note": "Detects tables from aligned selectable text. Scans require OCR; complex layouts, merged cells and column alignment require review. Excel uses one sheet per table; CSV exports one file per table.",
  "packages": [
    "pycryptodome",
    "pypdf",
    "openpyxl"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "pages"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
