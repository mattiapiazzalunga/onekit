{
  "copyright": "Copyright 2026 Mattia Piazzalunga",
  "spdx": "Apache-2.0",
  "id": "latex-to-md",
  "name": "LaTeX to Markdown",
  "group": "converters",
  "handler": "converters",
  "accepts": [
    "latex"
  ],
  "produces": "md",
  "browser": false,
  "fidelity": "compromise",
  "note": "Formatting, fonts, layout, formulas or unsupported elements may change. Scanned PDFs require OCR first.",
  "packages": [],
  "engines": [
    "pandoc"
  ],
  "multiple": false,
  "options": [],
  "input_mode": "text",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 8388608,
  "max_total_bytes": 134217728,
  "browser_max_total_bytes": 33554432,
  "browser_max_file_bytes": 8388608
}
