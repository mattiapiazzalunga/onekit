  "id": "pdf-to-text",
  "name": "PDF to text",
  "group": "converters",
  "handler": "pdf_text",
  "accepts": [
    "pdf"
  ],
  "produces": "txt",
  "fidelity": "compromise",
  "note": "Extracts selectable text to UTF-8, optionally retaining approximate layout. Scans require OCR; reading order, tables and columns need review.",
  "packages": [
    "pypdf"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "pages",
    "layout"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
