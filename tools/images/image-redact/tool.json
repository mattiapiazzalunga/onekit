  "id": "image-redact",
  "name": "Permanently redact image",
  "group": "images",
  "handler": "redaction",
  "accepts": [
    "png",
    "jpeg",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "ico"
  ],
  "produces": "png",
  "fidelity": "compromise",
  "note": "Replaces selected pixels with solid black and exports a new opaque PNG without original metadata or hidden alpha pixels. Single-frame images only. The original file is unchanged.",
  "packages": [
    "Pillow"
  ],
  "engines": [],
  "multiple": false,
  "options": [
    "regions"
  ],
  "input_mode": "typed",
  "min_files": 1,
  "max_files": 1,
  "max_file_bytes": 134217728,
  "max_total_bytes": 134217728
}
